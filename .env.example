# ---------------------------------------------------------------------------
# India Airfare Intelligence - environment template. Copy to .env and fill in.
# NO SECRETS ARE COMMITTED. This file documents names only.
# ---------------------------------------------------------------------------

# --- Database ---
# Portable local (docker compose):
DATABASE_URL=postgresql+asyncpg://airfare:airfare@db:5432/airfare
# Supabase (shared, for team presentations) - use the SESSION POOLER connection
# string from Supabase > Project Settings > Database, and swap the driver prefix:
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (Supabase supports Postgres RLS natively, which this platform relies on.)

REDIS_URL=redis://redis:6379/0

# --- App ---
ENVIRONMENT=local
DEBUG=true

# --- Statistical config (bundled into methodology_version for traceability) ---
METHODOLOGY_VERSION=idx-1.0.0
QUALITY_THRESHOLD=60
DEFAULT_ESTIMATOR=TRIMMED_MEAN_10
INDEX_BASE_PERIOD=2025-09-01
DEFAULT_CPI_WEIGHT_PCT=2.5
FORECAST_HORIZON_DAYS=14

# --- Data mode (LIVE | CACHED | REPLAY | empty=auto). Seeded demo runs REPLAY. ---
FORCE_DATA_MODE=REPLAY
LIVE_FRESHNESS_HOURS=6

# --- Collection (off by default; the demo runs on the seeded dataset) ---
COLLECTION_ENABLED=false
RESPECT_ROBOTS_TXT=true

# --- Security ---
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_RATE_LIMIT_PER_MIN=60

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
